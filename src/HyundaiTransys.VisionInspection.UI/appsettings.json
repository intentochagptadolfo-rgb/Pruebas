{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\HTVision\\logs\\vision-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConfigFilePath": "config/secure.config",
  "App": {
    "Mes": {
      "Role": "Server",
      "IpAddress": "0.0.0.0",
      "Port": 9000,
      "ReadTimeoutMs": 5000,
      "KeepAliveMs": 10000,
      "ReconnectInitialDelayMs": 1000,
      "ReconnectMaxDelayMs": 30000
    },
    "Keyence": {
      "IpAddress": "192.168.0.10",
      "Port": 8500,
      "CommandTimeoutMs": 3000,
      "ResultTimeoutMs": 5000
    },
    "Storage": {
      "OkImagesPath": "C:\\HTVision\\Images\\OK",
      "NgImagesPath": "C:\\HTVision\\Images\\NG",
      "RetentionDays": 30,
      "MaxDiskUsageGb": 50
    },
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=C:\\HTVision\\data\\inspections.db"
    },
    "Station": {
      "StationId": "LINE01-ST01",
      "LineName": "Assembly Line 01"
    }
  }
}
