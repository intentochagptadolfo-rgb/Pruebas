<Application x:Class="HyundaiTransys.VisionInspection.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HyundaiTransys.VisionInspection.UI.Views"
             xmlns:viewModels="clr-namespace:HyundaiTransys.VisionInspection.UI.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- DataTemplates for View-ViewModel binding -->
            <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ConfigurationViewModel}">
                <views:ConfigurationView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
