<Window x:Class="HyundaiTransys.VisionInspection.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HyundaiTransys.VisionInspection.UI.Converters"
        Title="Hyundai Transys — Vision Inspection"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1E1E1E"
        Foreground="White">
    <Window.Resources>
        <conv:ResultToColorConverter x:Key="ResultToColor"/>
        <conv:ResultToTextConverter x:Key="ResultToText"/>
        <conv:BoolToConnectionTextConverter x:Key="ConnectionText"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- status bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MES: " FontSize="16"/>
                <TextBlock Text="{Binding IsMesConnected, Converter={StaticResource ConnectionText}}"
                           FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="Camera: " FontSize="16"/>
                <TextBlock Text="{Binding IsCameraConnected, Converter={StaticResource ConnectionText}}"
                           FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="State: " FontSize="16"/>
                <TextBlock Text="{Binding State}" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- image viewer -->
            <Border Grid.Column="0" Margin="16" BorderBrush="#555" BorderThickness="2">
                <Image Source="{Binding LastImage}" Stretch="Uniform"/>
            </Border>

            <!-- result + metadata -->
            <StackPanel Grid.Column="1" Margin="16" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="24"
                        Background="{Binding LastResult, Converter={StaticResource ResultToColor}}">
                    <TextBlock Text="{Binding LastResult, Converter={StaticResource ResultToText}}"
                               FontSize="96" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="White"/>
                </Border>

                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="Model" FontSize="14" Opacity="0.7"/>
                    <TextBlock Text="{Binding ModelCode}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Serial" FontSize="14" Opacity="0.7" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding SerialNumber}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Keyence JOB" FontSize="14" Opacity="0.7" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding JobId}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>

                <Button Content="RETEST"
                        Command="{Binding RetestCommand}"
                        IsEnabled="{Binding IsRetestEnabled}"
                        Margin="0,32,0,0" Height="80" FontSize="32" FontWeight="Bold"
                        Background="#FFC107" Foreground="Black"/>
            </StackPanel>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Login" Command="{Binding OpenLoginCommand}" Margin="0,0,8,0" Padding="16,8"/>
                <Button Content="Configuration" Command="{Binding OpenConfigurationCommand}" Padding="16,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
